# Supabase Configuration
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Notion Integration (optional - for todo sync)
VITE_NOTION_API_KEY=
VITE_NOTION_DATABASE_ID=

# News API (newsapi.org)
VITE_NEWS_API_KEY=

# Unsplash API (unsplash.com/developers)
VITE_UNSPLASH_API_KEY=

# OpenAI API (for AI report generation)
VITE_OPENAI_API_KEY=

# Supabase Edge Function Secrets (set these in Supabase dashboard)
# OPENAI_API_KEY= (for embeddings)
# GITHUB_TOKEN= (for GitHub API enrichment)
